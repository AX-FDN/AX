struct Point {
    x: i32,
    y: i32,
}

enum Flag {
    On,
    Off,
}

fn total(point: Point) -> i32 {
    return point.x + point.y;
}

fn main() -> i32 {
    let mut point: Point = Point { x: 2, y: 3 };
    point.x = point.x + 1;

    let flag: Flag = Flag.On;
    if (flag == Flag.On) {
        println("enabled");
    } else {
        println("disabled");
    }

    println(flag);

    let mut values: [i32; 3] = [1, 2, 3];
    values[1] = current;
    println(values[1]);

    let mut current: i32 = total(point);
    while (current < 8) {
        current = current + 1;
    }

    for (let mut step: i32 = 0; step < 2; step = step + 1) {
        current = current + 1;
    }

    println(current);
    return 0;
}
