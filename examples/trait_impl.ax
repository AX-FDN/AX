trait Label {
    fn label(self: Self) -> string;
}

struct Command {
    name: string,
}

impl Label for Command {
    fn label(self: Command) -> string {
        return self.name;
    }
}

fn main() -> i32 {
    let command: Command = Command { name: "build" };
    println(command.label());
    return string_len(command.label());
}
