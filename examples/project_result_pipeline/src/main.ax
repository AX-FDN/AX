import std.cli;
import std.env;
import std.fs;
import std.path;
import std.process;
import std.report;
import std.result;

fn summarize_text_length(label: string, value: std.result.Result<string, string>) -> string {
    return match (value) { std.result.Result.Ok(text) => label + "_len=" + to_string(string_len(text)), std.result.Result.Err(message) => label + "_error=" + message };
}

fn summarize_string_result_ok(label: string, value: std.result.Result<string, string>) -> string {
    return match (value) { std.result.Result.Ok(_) => label + "_ok=true", std.result.Result.Err(message) => label + "_error=" + message };
}

fn summarize_process_success(label: string, value: std.result.Result<std.process.ProcessStatus, string>) -> string {
    return match (value) { std.result.Result.Ok(status) => label + "_success=" + to_string(status.success), std.result.Result.Err(message) => label + "_error=" + message };
}

fn summarize_process_code(label: string, value: std.result.Result<std.process.ProcessStatus, string>) -> string {
    return match (value) { std.result.Result.Ok(status) => label + "_code=" + to_string(status.code), std.result.Result.Err(message) => label + "_error=" + message };
}

fn build_pipeline_report(input_path: string, output_dir: string) -> std.result.Result<string, string> {
    std.fs.create_dir_all(output_dir);

    let input: string = std.fs.try_read_to_string(input_path)?;
    let env_path: string = std.env.try_get("PATH")?;
    let status: std.process.ProcessStatus = std.process.try_status_in(std.path.parent(input_path), "exit 0")?;
    let missing: std.result.Result<string, string> = std.fs.try_read_to_string(std.path.join(std.path.parent(input_path), "missing-result-pipeline.txt"));

    let mut report: string = "";
    report = std.report.append_path_stat(report, "input", input_path);
    report = std.report.append_line(report, "input_len=" + to_string(string_len(input)));
    report = std.report.append_line(report, "env_path_ok=" + to_string(string_len(env_path) > 0));
    report = std.report.append_line(report, "process_success=" + to_string(status.success));
    report = std.report.append_line(report, "process_code=" + to_string(status.code));
    report = std.report.append_line(report, summarize_string_result_ok("missing", missing));

    let report_path: string = std.path.join(output_dir, "RESULT-PIPELINE.txt");
    std.fs.write_string(report_path, report + "\n");
    return std.result.Result.ok(report_path);
}

fn main() -> i32 {
    let args_status: i32 = std.cli.require_min_args(argv_len(), 2, "examples/project_result_pipeline", "<input> <output_dir>");
    if (args_status != 0) {
        return args_status;
    }

    let result: std.result.Result<string, string> = build_pipeline_report(argv_get(0), argv_get(1));
    match (result) {
        std.result.Result.Ok(report_path) => {
            println("pipeline_report=" + report_path);
            return 0;
        }
        std.result.Result.Err(message) => {
            println("pipeline_error=" + message);
            return 1;
        }
    }
    return 1;
}
