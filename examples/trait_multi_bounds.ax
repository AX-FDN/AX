trait Label {
    fn label(self: Self) -> string;
}

trait ExitCode {
    fn exit_code(self: Self) -> i32;
}

struct Command {
    name: string,
    code: i32,
}

impl Label for Command {
    fn label(self: Command) -> string {
        return self.name;
    }
}

impl ExitCode for Command {
    fn exit_code(self: Command) -> i32 {
        return self.code;
    }
}

fn render<T: Label + ExitCode>(value: T) -> string {
    return value.label() + ":" + to_string(value.exit_code());
}

fn main() -> i32 {
    let command: Command = Command { name: "build", code: 5 };
    println(render(command));
    return command.code;
}
