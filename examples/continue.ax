fn main() -> i32 {
    let mut while_total: i32 = 0;
    let mut count: i32 = 0;

    while (count < 4) {
        count = count + 1;
        if (count == 2) {
            continue;
        }
        while_total = while_total + count;
    }

    let mut for_total: i32 = 0;
    for (let mut i: i32 = 0; i < 5; i = i + 1) {
        if (i == 2) {
            continue;
        }
        for_total = for_total + i;
    }

    println(while_total);
    println(for_total);
    return while_total + for_total;
}
