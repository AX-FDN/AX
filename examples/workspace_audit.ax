struct TextStats {
    lines: i32,
    nonempty: i32,
    headings: i32,
    action_items: i32,
}

struct AuditTotals {
    directories: i32,
    files: i32,
    text_files: i32,
    bytes: i32,
    lines: i32,
    nonempty: i32,
    headings: i32,
    action_items: i32,
}

fn zero_text_stats() -> TextStats {
    return TextStats {
        lines: 0,
        nonempty: 0,
        headings: 0,
        action_items: 0,
    };
}

fn zero_audit_totals() -> AuditTotals {
    return AuditTotals {
        directories: 0,
        files: 0,
        text_files: 0,
        bytes: 0,
        lines: 0,
        nonempty: 0,
        headings: 0,
        action_items: 0,
    };
}

fn is_text_file(path: string) -> bool {
    if (string_ends_with(path, ".ax")) {
        return true;
    }
    if (string_ends_with(path, ".md")) {
        return true;
    }
    if (string_ends_with(path, ".txt")) {
        return true;
    }
    if (string_ends_with(path, ".json")) {
        return true;
    }
    if (string_ends_with(path, ".toml")) {
        return true;
    }
    if (string_ends_with(path, ".ps1")) {
        return true;
    }
    if (string_ends_with(path, ".yml")) {
        return true;
    }
    if (string_ends_with(path, ".yaml")) {
        return true;
    }
    return false;
}

fn analyze_text(text: string) -> TextStats {
    let lines: [string] = string_split_lines(text);
    let mut stats: TextStats = zero_text_stats();

    for (let mut i: i32 = 0; i < len(lines); i = i + 1) {
        let line: string = string_trim(lines[i]);
        stats.lines = stats.lines + 1;

        if (string_len(line) != 0) {
            stats.nonempty = stats.nonempty + 1;
        }

        if (string_starts_with(line, "#")) {
            stats.headings = stats.headings + 1;
        }

        if (string_contains(line, "TODO")) {
            stats.action_items = stats.action_items + 1;
        } else {
            if (string_contains(line, "FIXME")) {
                stats.action_items = stats.action_items + 1;
            }
        }
    }

    return stats;
}

fn add_directory(totals: AuditTotals) -> AuditTotals {
    let mut next: AuditTotals = totals;
    next.directories = next.directories + 1;
    return next;
}

fn add_file(totals: AuditTotals, size: i32, text_stats: TextStats, counted_as_text: bool) -> AuditTotals {
    let mut next: AuditTotals = totals;
    next.files = next.files + 1;
    next.bytes = next.bytes + size;

    if (counted_as_text) {
        next.text_files = next.text_files + 1;
        next.lines = next.lines + text_stats.lines;
        next.nonempty = next.nonempty + text_stats.nonempty;
        next.headings = next.headings + text_stats.headings;
        next.action_items = next.action_items + text_stats.action_items;
    }

    return next;
}

fn display_label(path: string, depth: i32) -> string {
    if (depth == 0) {
        return path_file_name(path);
    }

    return path_file_name(path_parent(path)) + "/" + path_file_name(path);
}

fn append_dir_line(report: string, path: string, depth: i32, child_count: i32) -> string {
    let mut prefix: string = "";
    if (depth != 0) {
        prefix = "  ";
    }

    return report
        + prefix
        + display_label(path, depth)
        + " | dir | children="
        + to_string(child_count)
        + "\n";
}

fn append_file_line(report: string, path: string, depth: i32, size: i32, counted_as_text: bool, text_stats: TextStats) -> string {
    let mut prefix: string = "";
    if (depth != 0) {
        prefix = "  ";
    }

    let mut line: string =
        prefix
        + display_label(path, depth)
        + " | file | bytes="
        + to_string(size);

    if (counted_as_text) {
        line = line
            + " | lines="
            + to_string(text_stats.lines)
            + " | nonempty="
            + to_string(text_stats.nonempty)
            + " | headings="
            + to_string(text_stats.headings)
            + " | action_items="
            + to_string(text_stats.action_items);
    }

    return report + line + "\n";
}

fn audit_file(report: string, totals: AuditTotals, path: string, depth: i32) -> string {
    let size: i32 = fs_file_size(path);
    let mut text_stats: TextStats = zero_text_stats();
    let mut counted_as_text: bool = false;

    if (is_text_file(path)) {
        counted_as_text = true;
        text_stats = analyze_text(fs_read_to_string(path));
    }

    let updated_totals: AuditTotals = add_file(totals, size, text_stats, counted_as_text);
    let line: string = append_file_line(report, path, depth, size, counted_as_text, text_stats);

    return line
        + "files_total="
        + to_string(updated_totals.files)
        + "\n";
}

fn main() -> i32 {
    if (argv_len() < 2) {
        println("usage: axc run examples/workspace_audit.ax -- <root_dir> <output>");
        return 1;
    }

    let root_dir: string = argv_get(0);
    let output_path: string = argv_get(1);

    if (!fs_is_dir(root_dir)) {
        println("root dir is not a directory: " + root_dir);
        return 2;
    }

    let output_dir: string = path_parent(output_path);
    if (string_len(output_dir) != 0) {
        fs_create_dir_all(output_dir);
    }

    let entries: [string] = fs_read_dir(root_dir);
    let mut totals: AuditTotals = zero_audit_totals();
    let mut entry_report: string = "";

    for (let mut i: i32 = 0; i < len(entries); i = i + 1) {
        let entry: string = entries[i];

        if (fs_is_dir(entry)) {
            let children: [string] = fs_read_dir(entry);
            totals = add_directory(totals);
            entry_report = append_dir_line(entry_report, entry, 0, len(children));

            for (let mut child_index: i32 = 0; child_index < len(children); child_index = child_index + 1) {
                let child: string = children[child_index];

                if (fs_is_dir(child)) {
                    let nested_children: [string] = fs_read_dir(child);
                    totals = add_directory(totals);
                    entry_report = append_dir_line(entry_report, child, 1, len(nested_children));
                }

                if (fs_is_file(child)) {
                    let size: i32 = fs_file_size(child);
                    let mut text_stats: TextStats = zero_text_stats();
                    let mut counted_as_text: bool = false;

                    if (is_text_file(child)) {
                        counted_as_text = true;
                        text_stats = analyze_text(fs_read_to_string(child));
                    }

                    totals = add_file(totals, size, text_stats, counted_as_text);
                    entry_report = append_file_line(entry_report, child, 1, size, counted_as_text, text_stats);
                }
            }
        }

        if (fs_is_file(entry)) {
            let size: i32 = fs_file_size(entry);
            let mut text_stats: TextStats = zero_text_stats();
            let mut counted_as_text: bool = false;

            if (is_text_file(entry)) {
                counted_as_text = true;
                text_stats = analyze_text(fs_read_to_string(entry));
            }

            totals = add_file(totals, size, text_stats, counted_as_text);
            entry_report = append_file_line(entry_report, entry, 0, size, counted_as_text, text_stats);
        }
    }

    let summary: string =
        "root=" + path_resolve(root_dir)
        + "\nscope=top-level + one nested level"
        + "\ntop_level_entries=" + to_string(len(entries))
        + "\ndirectories=" + to_string(totals.directories)
        + "\nfiles=" + to_string(totals.files)
        + "\ntext_files=" + to_string(totals.text_files)
        + "\nbytes=" + to_string(totals.bytes)
        + "\nlines=" + to_string(totals.lines)
        + "\nnonempty=" + to_string(totals.nonempty)
        + "\nheadings=" + to_string(totals.headings)
        + "\naction_items=" + to_string(totals.action_items)
        + "\n\nentries:\n";

    fs_write_string(output_path, summary + entry_report);
    println("audited=" + output_path);
    return 0;
}
