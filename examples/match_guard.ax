enum Token {
    Number(i32),
    Word(string),
    End,
}

fn weight(token: Token) -> i32 {
    return match (token) {
        Token.Number(value) if value > 9 => 10,
        Token.Number(_) => 1,
        Token.Word(_) => 2,
        Token.End => 0,
    };
}

fn main() -> i32 {
    match (Token.Number(12)) {
        Token.Number(value) if value > 10 => {
            println(value);
        }
        _ => {
            println(0);
        }
    }

    println(weight(Token.Number(12)));
    println(weight(Token.Number(3)));
    println(weight(Token.Word("ax")));
    return weight(Token.End);
}
