enum Flag {
    On,
    Off,
}

fn choose(flag: Flag) -> i32 {
    match (flag) {
        Flag.On => {
            return 1;
        }
        Flag.Off => {
            return 2;
        }
    }
}

fn classify(value: i32) -> i32 {
    match (value) {
        0 => {
            return 7;
        }
        _ => {
            return value;
        }
    }
}

fn main() -> i32 {
    let truthy: bool = true;
    let mut total: i32 = 0;

    match (truthy) {
        true => {
            total = total + 10;
        }
        false => {
            total = total + 1;
        }
    }

    total = total + choose(Flag.On);
    total = total + choose(Flag.Off);
    total = total + classify(0);
    total = total + classify(5);

    println(total);
    return total;
}
