fn main() -> i32 {
    let left: [i32; 4] = [1, 2, 3, 4];
    let same: [i32; 4] = [0, 2, 3, 9];
    let other: [i32; 4] = [0, 2, 4, 9];
    let a: [i32] = left[1:3];
    let b: [i32] = same[1:3];
    let c: [i32] = other[1:3];
    let mut total: i32 = 0;

    if (a == b) {
        total = total + 1;
    }
    if (a != c) {
        total = total + 2;
    }

    return total;
}
