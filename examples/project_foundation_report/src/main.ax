fn build_file_report(path: string, text: string, stats: TextStats) -> string {
    let mut report: string = "";
    report = append_string_stat(report, "file", path_file_name(path));
    report = append_string_stat(report, "kind", classify_file_kind(path));
    report = append_int_stat(report, "chars", len(text));
    report = append_int_stat(report, "lines", stats.lines);
    report = append_int_stat(report, "nonempty", stats.nonempty);
    report = append_int_stat(report, "headings", stats.headings);
    report = append_int_stat(report, "action_items", stats.action_items);
    return report;
}

fn main() -> i32 {
    let args_status: i32 = require_min_args(argv_len(), 1, "examples/project_foundation_report", "<file>");
    if (args_status != 0) {
        return args_status;
    }

    let input_path: string = argv_get(0);
    let input_status: i32 = require_file(input_path, "file", 2);
    if (input_status != 0) {
        return input_status;
    }

    let text: string = fs_read_to_string(input_path);
    let stats: TextStats = analyze_text(text);
    let report: string = build_file_report(input_path, text, stats);

    println(report);
    return stats.action_items;
}
