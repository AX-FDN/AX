fn main() -> i32 {
    if (argv_len() < 2) {
        println("usage: axc run examples/extract_markdown_headings.ax -- <input> <output>");
        return 1;
    }

    let input_path: string = argv_get(0);
    let output_path: string = argv_get(1);

    if (!fs_is_file(input_path)) {
        println("input is not a file: " + input_path);
        return 2;
    }

    let output_dir: string = path_parent(output_path);
    if (string_len(output_dir) != 0) {
        fs_create_dir_all(output_dir);
    }

    let text: string = fs_read_to_string(input_path);
    let lines: [string] = string_split_lines(text);
    let mut report: string = "source=" + path_resolve(input_path) + "\n";
    let mut count: i32 = 0;

    for (let mut i: i32 = 0; i < len(lines); i = i + 1) {
        let line: string = string_trim(lines[i]);
        if (string_starts_with(line, "#")) {
            count = count + 1;
            report = report + line + "\n";
        }
    }

    report = "headings=" + to_string(count) + "\n" + report;
    fs_write_string(output_path, report);
    println("extracted=" + output_path);
    return 0;
}
