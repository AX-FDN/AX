import std.cli;
import std.env;
import std.fs;
import std.process;
import std.report;
import std.text;

fn main() -> i32 {
    let args_status: i32 = std.cli.require_min_args(argv_len(), 3, "examples/project_command_capture", "<working_dir> <command> <output>");
    if (args_status != 0) {
        return args_status;
    }

    let working_dir: string = argv_get(0);
    let command: string = argv_get(1);
    let output_path: string = argv_get(2);

    let dir_status: i32 = std.cli.require_directory(working_dir, "working dir", 2);
    if (dir_status != 0) {
        return dir_status;
    }

    let command_status: i32 = std.cli.require_non_empty_text(command, "command", 3);
    if (command_status != 0) {
        return command_status;
    }

    std.cli.ensure_output_parent(output_path);

    let output: string = std.process.capture_in(working_dir, command);
    let stats: std.text.TextStats = std.text.analyze(output);

    let mut report: string = "";
    report = std.report.append_path_stat(report, "working_dir", working_dir);
    report = std.report.append_string_stat(report, "command", command);
    report = std.report.append_int_stat(report, "bytes", len(output));
    report = std.report.append_int_stat(report, "lines", stats.lines);
    report = std.report.append_int_stat(report, "nonempty", stats.nonempty);
    report = std.report.append_bool_stat(report, "path_env_present", std.env.has("PATH"));
    report = std.report.append_section_details_or_none(report, "output", output, "(none)");

    std.fs.write_string(output_path, report);
    println("captured=" + output_path);
    return 0;
}
