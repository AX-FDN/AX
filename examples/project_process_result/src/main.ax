import std.cli;
import std.path;
import std.process;
import std.result;

fn main() -> i32 {
    let args_status: i32 = std.cli.require_min_args(argv_len(), 1, "examples/project_process_result", "<work_dir>");
    if (args_status != 0) {
        return args_status;
    }

    let work_dir: string = argv_get(0);
    let ok: std.result.Result<i32, string> = std.process.try_run_in(work_dir, "exit 0");
    let missing_dir: string = std.path.join(work_dir, "missing-process-result-dir");
    let missing: std.result.Result<i32, string> = std.process.try_run_in(missing_dir, "exit 0");
    let empty: std.result.Result<i32, string> = std.process.try_run("");

    println("run_status=" + to_string(std.result.unwrap_or(ok, -1)));
    println(std.result.error_or(missing, "unexpected"));
    println(std.result.error_or(empty, "unexpected"));
    return std.result.unwrap_or(ok, 99);
}
