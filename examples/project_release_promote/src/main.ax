fn main() -> i32 {
    let args_status: i32 = require_min_args(argv_len(), 2, "examples/project_release_promote", "<input> <release_dir>");
    if (args_status != 0) {
        return args_status;
    }

    let input_path: string = argv_get(0);
    let release_dir: string = argv_get(1);

    let input_status: i32 = require_file(input_path, "input", 2);
    if (input_status != 0) {
        return input_status;
    }

    let release_status: i32 = require_non_empty_text(release_dir, "release dir", 3);
    if (release_status != 0) {
        return release_status;
    }

    if (fs_exists(release_dir)) {
        if (!fs_is_dir(release_dir)) {
            return exit_with_message("release dir is not a directory: " + release_dir, 4);
        }
    } else {
        ensure_directory(release_dir);
    }

    let resolved_input: string = path_resolve(input_path);
    let file_name: string = path_file_name(resolved_input);
    if (string_len(file_name) == 0) {
        return exit_with_message("input has no file name: " + input_path, 5);
    }

    let promoted_path: string = path_join(release_dir, file_name);
    let replaced_existing: bool = fs_exists(promoted_path);
    if (replaced_existing) {
        fs_remove_file(promoted_path);
    }

    fs_rename(input_path, promoted_path);

    let receipt_path: string = path_join(release_dir, path_stem(file_name) + ".receipt.txt");
    let receipt: string = build_receipt(resolved_input, promoted_path, replaced_existing);

    fs_write_string(receipt_path, receipt);
    println("promoted=" + promoted_path);
    return 0;
}
