import lib.receipt;
import std.cli;
import std.fs;
import std.path;

fn main() -> i32 {
    let args_status: i32 = std.cli.require_min_args(argv_len(), 2, "examples/project_release_promote", "<input> <release_dir>");
    if (args_status != 0) {
        return args_status;
    }

    let input_path: string = argv_get(0);
    let release_dir: string = argv_get(1);

    let input_status: i32 = std.cli.require_file(input_path, "input", 2);
    if (input_status != 0) {
        return input_status;
    }

    let release_status: i32 = std.cli.require_non_empty_text(release_dir, "release dir", 3);
    if (release_status != 0) {
        return release_status;
    }

    if (std.fs.exists(release_dir)) {
        if (!std.fs.is_dir(release_dir)) {
            return std.cli.exit_with_message("release dir is not a directory: " + release_dir, 4);
        }
    } else {
        std.fs.create_dir_all(release_dir);
    }

    let resolved_input: string = std.path.resolve(input_path);
    let file_name: string = std.path.file_name(resolved_input);
    if (string_len(file_name) == 0) {
        return std.cli.exit_with_message("input has no file name: " + input_path, 5);
    }

    let promoted_path: string = std.path.join(release_dir, file_name);
    let replaced_existing: bool = std.fs.exists(promoted_path);
    if (replaced_existing) {
        std.fs.remove_file(promoted_path);
    }

    std.fs.rename(input_path, promoted_path);

    let receipt_path: string = std.path.join(release_dir, std.path.stem(file_name) + ".receipt.txt");
    let receipt: string = lib.receipt.build_receipt(resolved_input, promoted_path, replaced_existing);

    std.fs.write_string(receipt_path, receipt);
    println("promoted=" + promoted_path);
    return 0;
}
