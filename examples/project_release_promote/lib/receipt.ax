module lib.receipt;

import std.fs;
import std.path;
import std.report;

fn build_receipt(source_path: string, promoted_path: string, replaced_existing: bool) -> string {
    let mut report: string = "";
    report = std.report.append_path_stat(report, "source", source_path);
    report = std.report.append_path_stat(report, "promoted", promoted_path);
    report = std.report.append_path_stat(report, "release_dir", std.path.parent(promoted_path));
    report = std.report.append_string_stat(report, "name", std.path.file_name(promoted_path));
    report = std.report.append_string_stat(report, "stem", std.path.stem(promoted_path));
    report = std.report.append_string_stat(report, "extension", std.path.extension(promoted_path));
    report = std.report.append_bool_stat(report, "replaced_existing", replaced_existing);
    report = std.report.append_bool_stat(report, "source_exists_after", std.fs.exists(source_path));
    report = std.report.append_bool_stat(report, "release_is_dir", std.fs.is_dir(std.path.parent(promoted_path)));
    report = std.report.append_bool_stat(report, "promoted_is_file", std.fs.is_file(promoted_path));
    report = std.report.append_int_stat(report, "size", std.fs.file_size(promoted_path));
    return report + "\n";
}
