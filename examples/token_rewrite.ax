enum TokenKind {
    Number,
    Plus,
    End,
}

struct Token {
    kind: TokenKind,
    value: i32,
}

fn main() -> i32 {
    let mut tokens: [Token; 5] = [
        Token { kind: TokenKind.Number, value: 7 },
        Token { kind: TokenKind.Plus, value: 0 },
        Token { kind: TokenKind.Number, value: 11 },
        Token { kind: TokenKind.Number, value: 3 },
        Token { kind: TokenKind.End, value: 0 },
    ];
    let mut index: i32 = 0;
    let mut total: i32 = 0;

    while (index < len(tokens)) {
        if (tokens[index].kind == TokenKind.Number) {
            tokens[index].value = tokens[index].value + 10;
            total = total + tokens[index].value;
        }
        index = index + 1;
    }

    println(tokens);
    println(total);
    return 0;
}
