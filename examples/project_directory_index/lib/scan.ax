struct IndexedEntry {
    report: string,
    totals: IndexTotals,
}

fn index_entry(report: string, totals: IndexTotals, path: string, depth: i32) -> IndexedEntry {
    if (fs_is_dir(path)) {
        let children: [string] = fs_read_dir(path);
        let mut next_report: string = append_directory_entry(report, path, depth, len(children));
        let mut next_totals: IndexTotals = add_directory(totals);

        for (let mut i: i32 = 0; i < len(children); i = i + 1) {
            let indexed: IndexedEntry = index_entry(next_report, next_totals, children[i], depth + 1);
            next_report = indexed.report;
            next_totals = indexed.totals;
        }

        return IndexedEntry { report: next_report, totals: next_totals };
    }

    if (fs_is_file(path)) {
        let kind: string = classify_file_kind(path);
        let counted_as_text: bool = is_text_file(path);
        let size: i32 = fs_file_size(path);
        let mut details: string = "file | kind=";
        details = details + kind;
        details = details + " | text=";
        details = details + to_string(counted_as_text);
        details = details + " | bytes=";
        details = details + to_string(size);
        return IndexedEntry {
            report: append_workspace_line(report, path, depth, details),
            totals: add_file(totals, size, counted_as_text),
        };
    }

    return IndexedEntry {
        report: append_other_entry(report, path, depth, classify_file_kind(path)),
        totals: add_other(totals),
    };
}
