module lib.report;

import lib.index_totals;
import std.report;

fn build_summary(root_dir: string, totals: lib.index_totals.IndexTotals, details: string) -> string {
    let mut report: string = "";
    report = std.report.append_path_stat(report, "root", root_dir);
    report = std.report.append_int_stat(report, "entries", totals.entries);
    report = std.report.append_int_stat(report, "directories", totals.directories);
    report = std.report.append_int_stat(report, "files", totals.files);
    report = std.report.append_int_stat(report, "text_files", totals.text_files);
    report = std.report.append_int_stat(report, "bytes", totals.bytes);
    return std.report.append_section_details_or_none(report, "entries", details, "(none)");
}
