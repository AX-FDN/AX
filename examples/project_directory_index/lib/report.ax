fn append_directory_entry(report: string, path: string, depth: i32, child_count: i32) -> string {
    return append_workspace_line(report, path, depth, "dir | children=" + to_string(child_count));
}

fn append_file_entry(report: string, path: string, depth: i32, kind: string, counted_as_text: bool, size: i32) -> string {
    let details: string =
        "file | kind="
        + kind
        + " | text="
        + to_string(counted_as_text)
        + " | bytes="
        + to_string(size);
    return append_workspace_line(report, path, depth, details);
}

fn append_other_entry(report: string, path: string, depth: i32, kind: string) -> string {
    return append_workspace_line(report, path, depth, "other | kind=" + kind);
}

fn build_summary(root_dir: string, totals: IndexTotals, details: string) -> string {
    let mut report: string = "";
    report = append_path_stat(report, "root", root_dir);
    report = append_int_stat(report, "entries", totals.entries);
    report = append_int_stat(report, "directories", totals.directories);
    report = append_int_stat(report, "files", totals.files);
    report = append_int_stat(report, "text_files", totals.text_files);
    report = append_int_stat(report, "bytes", totals.bytes);
    return append_section_details_or_none(report, "entries", details, "(none)");
}
