fn main() -> i32 {
    let args_status: i32 = require_min_args(argv_len(), 3, "examples/project_workspace_search_report", "<root_dir> <needle> <output>");
    if (args_status != 0) {
        return args_status;
    }
    let root_dir: string = argv_get(0);
    let needle: string = argv_get(1);
    let output_path: string = argv_get(2);
    let root_status: i32 = require_directory(root_dir, "root dir", 2);
    if (root_status != 0) {
        return root_status;
    }
    let needle_status: i32 = require_non_empty_text(needle, "needle", 3);
    if (needle_status != 0) {
        return needle_status;
    }
    ensure_output_parent(output_path);
    let entries: [string] = fs_read_dir(root_dir);
    let mut totals: SearchTotals = zero_search_totals();
    let mut match_report: string = "";

    for (let mut i: i32 = 0; i < len(entries); i = i + 1) {
        let searched: FileSearch = search_path(match_report, totals, entries[i], 0, needle);
        match_report = searched.report;
        totals = searched.totals;
    }

    let summary: string = append_section_details_or_none(build_summary(root_dir, needle, totals), "matches", match_report, "(none)");
    fs_write_string(output_path, summary);
    println("searched=" + output_path);
    return 0;
}
