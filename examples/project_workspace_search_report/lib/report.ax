fn render_match_lines(match_lines: string_list) -> string {
    if (len(match_lines) == 0) {
        return "";
    }

    return string_list_join(match_lines, "\n") + "\n";
}

fn build_summary(root_dir: string, needle: string, totals: SearchTotals) -> string {
    let mut report: string = "";
    report = append_path_stat(report, "root", root_dir);
    report = append_string_stat(report, "needle", needle);
    report = append_string_stat(report, "scope", "recursive");
    report = append_int_stat(report, "searchable_files", totals.searchable_files);
    report = append_int_stat(report, "matched_files", totals.matched_files);
    report = append_int_stat(report, "bytes", totals.bytes);
    report = append_int_stat(report, "lines", totals.lines);
    report = append_int_stat(report, "matched_lines", totals.matched_lines);
    return report;
}
