fn main() -> i32 {
    let args_status: i32 = require_min_args(argv_len(), 2, "examples/project_text_normalize", "<input> <output_dir>");
    if (args_status != 0) {
        return args_status;
    }

    let input_path: string = argv_get(0);
    let output_dir: string = argv_get(1);

    let input_status: i32 = require_file(input_path, "input", 2);
    if (input_status != 0) {
        return input_status;
    }

    let output_status: i32 = require_non_empty_text(output_dir, "output dir", 3);
    if (output_status != 0) {
        return output_status;
    }

    ensure_directory(output_dir);

    let source: string = fs_read_to_string(input_path);
    let normalized: string = normalize_text_content(source);
    let before: TextStats = analyze_text(source);
    let after: TextStats = analyze_text(normalized);
    let changed: bool = normalized != source;

    let output_path: string = path_join(output_dir, path_stem(input_path) + ".normalized.txt");
    let report_path: string = path_join(output_dir, "NORMALIZE-REPORT.txt");

    fs_write_string(output_path, normalized);
    fs_write_string(report_path, build_report(input_path, output_path, changed, before, after, normalized));

    println("normalized=" + output_path);
    return 0;
}
