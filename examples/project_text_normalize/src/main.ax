import lib.normalize;
import lib.report;
import std.cli;
import std.fs;
import std.path;
import std.text;

fn main() -> i32 {
    let args_status: i32 = std.cli.require_min_args(argv_len(), 2, "examples/project_text_normalize", "<input> <output_dir>");
    if (args_status != 0) {
        return args_status;
    }

    let input_path: string = argv_get(0);
    let output_dir: string = argv_get(1);

    let input_status: i32 = std.cli.require_file(input_path, "input", 2);
    if (input_status != 0) {
        return input_status;
    }

    let output_status: i32 = std.cli.require_non_empty_text(output_dir, "output dir", 3);
    if (output_status != 0) {
        return output_status;
    }

    std.fs.create_dir_all(output_dir);

    let source: string = std.fs.read_to_string(input_path);
    let normalized: string = lib.normalize.normalize_text_content(source);
    let before: std.text.TextStats = std.text.analyze(source);
    let after: std.text.TextStats = std.text.analyze(normalized);
    let changed: bool = normalized != source;

    let output_path: string = std.path.join(output_dir, std.path.stem(input_path) + ".normalized.txt");
    let report_path: string = std.path.join(output_dir, "NORMALIZE-REPORT.txt");

    std.fs.write_string(output_path, normalized);
    std.fs.write_string(report_path, lib.report.build_report(input_path, output_path, changed, before, after, normalized));

    println("normalized=" + output_path);
    return 0;
}
