enum Status {
    Code(i32),
    Flag(bool),
    Label(string),
    Done,
}

fn main() -> i32 {
    let code: Status = Status.Code(7);
    let flag: Status = Status.Flag(true);
    let label: Status = Status.Label("ok");
    let done: Status = Status.Done;

    println(code);
    println(flag);
    println(label);
    println(done);

    return 58;
}
