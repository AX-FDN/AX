module std.fs;

import std.result;

fn read_to_string(path: string) -> string {
    return fs_read_to_string(path);
}

fn try_read_to_string(path: string) -> std.result.Result<string, string> {
    if (fs_is_file(path)) {
        return std.result.Result.ok(fs_read_to_string(path));
    }
    return std.result.Result.err("readable file does not exist: " + path);
}

fn write_string(path: string, contents: string) -> i32 {
    fs_write_string(path, contents);
    return 0;
}

fn copy_file(source_path: string, destination_path: string) -> i32 {
    return fs_copy_file(source_path, destination_path);
}

fn create_dir_all(path: string) -> i32 {
    fs_create_dir_all(path);
    return 0;
}

fn exists(path: string) -> bool {
    return fs_exists(path);
}

fn remove_file(path: string) -> i32 {
    fs_remove_file(path);
    return 0;
}

fn remove_dir_all(path: string) -> i32 {
    fs_remove_dir_all(path);
    return 0;
}

fn rename(from: string, to: string) -> i32 {
    fs_rename(from, to);
    return 0;
}

fn read_dir(path: string) -> [string] {
    return fs_read_dir(path);
}

fn try_read_dir(path: string) -> std.result.Result<[string], string> {
    if (fs_is_dir(path)) {
        return std.result.Result.ok(fs_read_dir(path));
    }
    return std.result.Result.err("readable directory does not exist: " + path);
}

fn file_size(path: string) -> i32 {
    return fs_file_size(path);
}

fn try_file_size(path: string) -> std.result.Result<i32, string> {
    if (fs_is_file(path)) {
        return std.result.Result.ok(fs_file_size(path));
    }
    return std.result.Result.err("sized file does not exist: " + path);
}

fn is_file(path: string) -> bool {
    return fs_is_file(path);
}

fn is_dir(path: string) -> bool {
    return fs_is_dir(path);
}
