module std.result;

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    fn ok(value: T) -> Result<T, E> {
        return Result.Ok(value);
    }

    fn err(error: E) -> Result<T, E> {
        return Result.Err(error);
    }
}

fn is_ok<T, E>(value: Result<T, E>) -> bool {
    return match (value) { Result.Ok(_) => true, Result.Err(_) => false };
}

fn is_err<T, E>(value: Result<T, E>) -> bool {
    return match (value) { Result.Ok(_) => false, Result.Err(_) => true };
}

fn unwrap_or<T, E>(value: Result<T, E>, fallback: T) -> T {
    return match (value) { Result.Ok(found) => found, Result.Err(_) => fallback };
}

fn error_or<T, E>(value: Result<T, E>, fallback: E) -> E {
    return match (value) { Result.Ok(_) => fallback, Result.Err(error) => error };
}

fn prefix_error<T>(value: Result<T, string>, prefix: string) -> Result<T, string> {
    return match (value) {
        Result.Ok(found) => Result.Ok(found),
        Result.Err(error) => Result.Err(prefix + error),
    };
}

fn replace_error<T>(value: Result<T, string>, message: string) -> Result<T, string> {
    return match (value) {
        Result.Ok(found) => Result.Ok(found),
        Result.Err(_) => Result.Err(message),
    };
}
