module std.env;

import std.result;

fn has(name: string) -> bool {
    return env_has(name);
}

fn get(name: string) -> string {
    return env_get(name);
}

fn try_get(name: string) -> std.result.Result<string, string> {
    if (env_has(name)) {
        return std.result.Result.ok(env_get(name));
    }
    return std.result.Result.err("missing environment variable: " + name);
}
