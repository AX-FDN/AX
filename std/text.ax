module std.text;

struct TextStats {
    lines: i32,
    nonempty: i32,
    headings: i32,
    action_items: i32,
}

fn zero_text_stats() -> TextStats {
    return TextStats { lines: 0, nonempty: 0, headings: 0, action_items: 0 };
}

fn analyze(text: string) -> TextStats {
    let lines: [string] = string_split_lines(text);
    let mut stats: TextStats = zero_text_stats();
    for (let mut i: i32 = 0; i < len(lines); i = i + 1) {
        let line: string = string_trim(lines[i]);
        stats.lines = stats.lines + 1;
        if (string_len(line) != 0) {
            stats.nonempty = stats.nonempty + 1;
        }
        if (string_starts_with(line, "#")) {
            stats.headings = stats.headings + 1;
        }
        if (string_contains(line, "TODO")) {
            stats.action_items = stats.action_items + 1;
        } else if (string_contains(line, "FIXME")) {
            stats.action_items = stats.action_items + 1;
        }
    }
    return stats;
}

fn normalize_content(source: string) -> string {
    let tab_expanded: string = string_replace(source, "\t", "    ");
    let lines: [string] = string_split_lines(tab_expanded);
    let mut normalized: string = "";
    let mut previous_blank: bool = false;

    for (let mut i: i32 = 0; i < len(lines); i = i + 1) {
        let trimmed: string = string_trim(lines[i]);
        let is_blank: bool = string_len(trimmed) == 0;

        if (is_blank) {
            if (!previous_blank) {
                normalized = normalized + "\n";
                previous_blank = true;
            }
        } else {
            normalized = normalized + trimmed + "\n";
            previous_blank = false;
        }
    }

    if (!string_ends_with(normalized, "\n")) {
        normalized = normalized + "\n";
    }

    return normalized;
}
