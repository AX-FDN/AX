fn display_label(path: string, depth: i32) -> string {
    let name: string = path_file_name(path);
    if (depth <= 0) {
        return name;
    }

    let parent_name: string = path_file_name(path_parent(path));
    if (string_len(parent_name) == 0) {
        return name;
    }

    return parent_name + "/" + name;
}

fn depth_prefix(depth: i32) -> string {
    let mut prefix: string = "";
    for (let mut i: i32 = 0; i < depth; i = i + 1) {
        prefix = prefix + "  ";
    }
    return prefix;
}

fn append_workspace_line(report: string, path: string, depth: i32, details: string) -> string {
    return report + depth_prefix(depth) + display_label(path, depth) + " | " + details + "\n";
}

fn append_named_line(report: string, path: string, details: string) -> string {
    return report + path_file_name(path) + " | " + details + "\n";
}
